# Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
DATA_DIR=data

# Ingestion
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# OpenAI — embeddings + generation (required from Module 2)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# Qdrant — vector store (local Docker; leave API key blank)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=filings
QDRANT_TIMEOUT=60

# LangSmith — optional tracing (off by default)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=secfiler-rag
LANGSMITH_API_KEY=
