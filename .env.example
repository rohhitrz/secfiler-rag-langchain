# Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
DATA_DIR=data

# OpenAI — embeddings + generation (required once indexing lands)
OPENAI_API_KEY=

# Qdrant — vector store (local Docker; leave API key blank)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LangSmith — optional tracing (off by default)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=secfiler-rag
LANGSMITH_API_KEY=
